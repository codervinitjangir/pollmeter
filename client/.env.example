# Backend WebSocket/REST API URL
# Leave blank for local development (Vite proxies to localhost:3001)
# For custom production deployment, set to your backend URL (e.g. https://pollmeter.onrender.com)
VITE_SERVER_URL=https://pollmeter.onrender.com

# Google OAuth Client ID for 1-Click "Sign in with Google" button
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
